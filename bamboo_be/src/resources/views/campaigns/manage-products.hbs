<div class='content-wrapper'>
    <div class='page-header'>
        <h3 class='page-title'>
            <span class='page-title-icon bg-gradient-primary text-white me-2'>
                <i class='mdi mdi-home'></i>
            </span>
            Chiến dịch - Chương trình
        </h3>
        <nav aria-label='breadcrumb'>
            <ul class='breadcrumb'>
                <li class='breadcrumb-item active' aria-current='page'>
                    <span></span>Overview
                    <i class='mdi mdi-alert-circle-outline icon-sm text-primary align-middle'></i>
                </li>
            </ul>
        </nav>
    </div>
    <div class="container-fluid">
        <h1 class="text-center">Quản lý sản phẩm trong chiến dịch: {{campaign.name}}</h1>

        <form method="POST" action="/campaigns/{{campaign._id}}/products">
            <table class="table my-5">
                <thead>
                    <tr class="text-center">
                        <th scope="col">Chọn</th>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Giá gốc</th>
                        <th scope="col">Giá KM (nếu có)</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each products}}
                    <tr>
                        <td class="text-center">
                            <input class="form-check-input" type="checkbox" 
                                name="selectedProducts[]" 
                                value="{{this._id}}" 
                                {{#if this.checked}}checked{{/if}}>
                        </td>
                        <td class="manage-product-name">{{this.name}}</td>
                        <td class="text-center price" data-price="{{this.price}}">
                            {{formatPrice this.price}}
                        </td>
                        <td>
                            <select class="form-select mb-2" name="discounts[p{{this._id}}]">
                                <option value="">-- Chọn Discount --</option>
                                {{#each ../discounts}}
                                    <option value="{{this._id}}" data-percent="{{this.price}}"
                                        {{#if (eq this._id ../selectedDiscountId)}}selected{{/if}}>
                                        {{this.name}} - {{this.price}}%
                                    </option>
                                {{/each}}
                            </select>
                            <input class="form-control" type="number"
                                name="salePrices[p{{this._id}}]"
                                value="{{this.salePrice}}"
                                placeholder="Nhập giá KM (nếu có)">
                            <span class="sale-price-preview text-muted"></span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            <button type="submit" class="btn btn-success">Lưu</button>
        </form>
    </div>
</div>

<script>
    function formatPriceClient(price) {
       if (price === null || price === undefined || price === '') return '';
            const num = Number(price);
            if (Number.isNaN(num)) return '';
            return new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 }).format(num) + ' VNĐ';
    }
    document.addEventListener("DOMContentLoaded", () => {
        const rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {
            const price = parseFloat(row.querySelector(".price").dataset.price);
            const discountSelect = row.querySelector("select[name^='discounts']");
            const salePriceInput = row.querySelector("input[name^='salePrices']");
            const preview = row.querySelector(".sale-price-preview");

            // Khởi tạo preview ban đầu
            if (salePriceInput.value) {
                preview.textContent = formatPriceClient(salePriceInput.value);
            }

            // Khi chọn discount
            discountSelect?.addEventListener("change", () => {
                const selectedOption = discountSelect.options[discountSelect.selectedIndex];
                const percent = selectedOption.dataset.percent ? parseFloat(selectedOption.dataset.percent) : null;

                if (percent) {
                    const discountedPrice = Math.round(price * (1 - percent / 100));
                    salePriceInput.value = discountedPrice;
                    preview.textContent = formatPriceClient(discountedPrice);
                } else {
                    salePriceInput.value = "";
                    preview.textContent = "";
                }
            });

            // Khi user nhập tay
            salePriceInput.addEventListener("input", () => {
                preview.textContent = salePriceInput.value ? formatPriceClient(salePriceInput.value) : "";
            });
        });
    });
</script>

