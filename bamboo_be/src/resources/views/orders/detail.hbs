                    </div>
                </div>

                <div class='list-products-invoice'>
                    <h3>Thông tin sản phẩm:</h3>
                    <div class='container-table'>
                        <table style='height: 140px; width: 100%' class='table table-borderless text-center'>
                            <thead>
                                <tr class='table-primary'>
                                    <th scope='col'>Sản phẩm</th>
                                    <th scope='col'>Số lượng</th>
                                    <th scope='col'>Màu</th>
                                    <th scope='col'>Size</th>
                                    <th scope='col'>Giá sản phẩm</th>
                                    <th scope='col'>Thuế</th>
                                    <th scope='col'>Tổng giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each orderItems}}
                                    <tr>
                                        <td><span class='name-short'>{{this.productId.name}}</span></td>
                                        <td>{{this.quantity}}</td>
                                        <td>
                                            {{#each this.colorIds}}
                                                <span>{{this.name}}</span>{{#unless @last}}, {{/unless}}
                                            {{/each}}
                                        </td>
                                        <td>
                                            {{#each this.sizeIds}}
                                                <span>{{this.name}}</span>{{#unless @last}}, {{/unless}}
                                            {{/each}}
                                        </td>
                                        <td>{{formatPrice this.productId.price}}</td>
                                        <td>1%</td>
                                        <td>{{formatPrice this.unitPrice}}</td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <div class='footer-table'>
                        <div class='mb-2 d-flex align-items-center justify-content-between'>
                            <span class='footer-label-table'>Thuế</span>
                            <span>1%</span>
                        </div>
                        <div class='mb-2 d-flex align-items-center justify-content-between'>
                            <span class='footer-label-table'>Giảm giá hóa đơn</span>
                            {{#each orderItems}}
                                <span>
                                    {{formatPrice this.discountId.price}}
                                </span>
                            {{/each}}
                        </div>
                        <div class='mb-2 d-flex align-items-center justify-content-between'>
                            <span><strong>Tổng tiền hóa đơn</strong></span>
                            <span>{{formatPrice order.totalAmount}}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class='col-xl-4 col-sm-4 col-xs-12'>
                <div class='col-right'>
                    <div class='mb-3'>
                        <label for='status_payment' class='form-label'>Tình trạng</label>
                        <input
                            value='{{checkTextStatus order.status}}'
                            type='text'
                            disabled
                            class='form-control'
                            id='status_payment'
                            placeholder='Tình trạng...'
                        />
                    </div>
                    <div class='payment-details d-flex flex-column align-items-start justify-content-start'>
                        <span>Phương thức thanh toán:</span>
                        <span><strong></strong></span>
                    </div>
                    <div class='timeline-invoices'>
                        <span>Thời gian mua:</span>
                        <div class='container-timeline'>
                            <ul class='timeline-1 text-black'>
                                {{#each userOrders}}
                                    <li class='event' data-date='{{formatDate this.createdAt "ll"}}'>
                                        <a href='/orders/detail/{{this.slug}}' class='mb-2'>
                                            {{this.userId.lastName}}
                                            {{this.userId.firstName}}
                                        </a>
                                        <p>Đã đặt hàng vào
                                            {{formatDate this.createdAt '' true}}
                                        </p>
                                    </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class='signature-user d-flex flex-column align-items-end justify-content-end'>
            <div class='d-flex flex-column align-items-center p-4 my-4 me-5'>
                <span>Chữ ký khách hàng</span>
                <span>{{signature}}</span>
            </div>
        </div>
    </div>
</div>