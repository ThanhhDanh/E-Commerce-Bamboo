<div class='content-wrapper'>
    <div class='page-header'>
        <h3 class='page-title'>
            <span class='page-title-icon bg-gradient-primary text-white me-2'>
                <i class='mdi mdi-home'></i>
            </span>
            Bình luận đã xóa
        </h3>
        <nav aria-label='breadcrumb'>
            <ul class='breadcrumb'>
                <li class='breadcrumb-item active' aria-current='page'>
                    <span></span>Overview
                    <i class='mdi mdi-alert-circle-outline icon-sm text-primary align-middle'></i>
                </li>
            </ul>
        </nav>
    </div>
    <div class='trash-header'>
        <a href='/comments/create'>
            <i class='fa-solid fa-arrow-left'></i>
            Danh sách bình luận
        </a>
        <h1>Danh sách bình luận đã xóa</h1>
    </div>

    <table class='table mt-4'>
        <thead>
            <tr>
                <th scope='col'>#</th>
                <th scope='col'>Bình luận</th>
                <th scope='col'>Sản phẩm bình luận</th>
                <th scope='col'>Người dùng bình luận</th>
                <th scope='col'>Thời gian tạo</th>
                <th scope='col'>#</th>
            </tr>
        </thead>
        <tbody>
            {{#each comments}}
                <tr>
                    <td>{{this._id}}</td>
                    <td>{{this.content}}</td>
                    <td>{{this.productId}}</td>
                    <td>{{this.userId}}</td>
                    <td>{{formatDate this.deletedAt 'll'}}</td>
                    <td class='d-flex flex-column'>
                        <a href='' class='btn btn-info mb-4 btn-restore' data-id='{{this._id}}'>
                            <i class='fa-solid fa-clock-rotate-left'></i>
                        </a>
                        <a
                            href=''
                            class='btn btn-danger'
                            data-id='{{this._id}}'
                            data-bs-toggle='modal'
                            data-bs-target='#delete-shop-modal'
                        >
                            <i class='fa-solid fa-xmark'></i>
                        </a>
                    </td>
                </tr>

            {{else}}
                <tr>
                    <td colspan='8' class='text-center'>Thùng rác rỗng.
                        <a class='text-danger' href='/comments/trash/comment'>Danh sách bình luận</a>
                    </td>
                </tr>

            {{/each}}
        </tbody>
    </table>
</div>

{{! Confirm delete }}
<div class='modal fade' id='delete-comment-modal' tabindex='-1' aria-labelledby='exampleModalLabel' aria-hidden='true'>
    <div class='modal-dialog'>
        <div class='modal-content'>
            <div class='modal-header'>
                <h1 class='modal-title' id='exampleModalLabel'>Xóa bình luận??</h1>
                <button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
            </div>
            <div class='modal-body'>
                Bạn có chắc chắn xóa bình luận này?? Khi không khôi phục lại được.
            </div>
            <div class='modal-footer'>
                <button type='button' class='btn btn-secondary' data-bs-dismiss='modal'>Hủy</button>
                <button id='btn-delete-comment' type='button' class='btn btn-danger'>Xóa vĩnh viễn</button>
            </div>
        </div>
    </div>
</div>

{{! Delete form }}
<form method='POST' name='delete-comment-form'></form>
<form method='POST' name='restore-comment-form'></form>

<script>
    document.addEventListener("DOMContentLoaded", function(){ var commentId; var deleteForm =
    document.forms['delete-comment-form']; var restoreForm = document.forms['restore-comment-form']; var
    btnDeleteComment = document.getElementById('btn-delete-comment'); var btnRestore = $('.btn-restore');
    $('#delete-comment-modal').on('show.bs.modal',function(e) { var button = $(e.relatedTarget); commentId =
    button.data('id'); }); btnDeleteComment.onclick = function() { deleteForm.action = "/comments/" + commentId +
    '/force?_method=DELETE'; deleteForm.submit(); } //Restore click btnRestore.click(function (e) { e.preventDefault();
    var commentId = $(this).data('id'); restoreForm.action = "/comments/" + commentId + '/restore?_method=PATCH';
    restoreForm.submit(); }) })

</script>