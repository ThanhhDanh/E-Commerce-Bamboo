        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="/css/style.css">
        <!-- plugins:css -->
        <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
        <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
        <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
        <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
        <!-- endinject -->
        <!-- Plugin css for this page -->
        <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css" />
        <link rel="stylesheet" href="/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css">
        <!-- End plugin css for this page -->

        {{!-- Select2 --}}
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select/dist/css/bootstrap-select.min.css">

         <!-- Css chat -->
        <link href="/assets/libs/magnific-popup/magnific-popup.css" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" href="/assets/libs/owl.carousel/assets/owl.carousel.min.css">
        <link rel="stylesheet" href="/assets/libs/owl.carousel/assets/owl.theme.default.min.css">
        <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
        <link href="/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />

        {{!-- Flatpickr --}}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    </head>
    <body>
        <div class="app">
            {{> header}}
            <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_sidebar.html -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
          <ul class="nav">
            <li class="nav-item nav-profile">
              <a href="/" class="nav-link">
                <div class="nav-profile-image">
                  <img src="{{user.avatar}}" alt="{{user.firstName}}" />
                  <span class="login-status online"></span>
                  <!--change to offline or busy as needed-->
                </div>
                <div class="nav-profile-text d-flex flex-column">
                  <span class="font-weight-bold mb-2">{{user.firstName}}</span>
                  <span class="text-secondary text-small">{{user.role}}</span>
                </div>
                <i class="mdi mdi-bookmark-check text-success nav-profile-badge"></i>
              </a>
            </li>
            <li class="nav-item {{isActive currentPath '/home'}}">
              <a class="nav-link" href="/">
                <span class="menu-title">Dashboard</span>
                <i class="mdi mdi-home menu-icon"></i>
              </a>
            </li>
            <li class="nav-item {{isActive currentPath '/categories/create'}}">
                <a class="nav-link" data-bs-toggle="collapse" href="#categories-collapse" aria-expanded="false" aria-controls="categories-collapse">
                    <span class="menu-title">Danh mục</span>
                    <i class="menu-arrow"></i>
                    <i class="mdi mdi-crosshairs-gps menu-icon"></i>
                </a>
                <div class="collapse" id="categories-collapse">
                    <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link" href="/categories/create">Thêm danh mục</a>
                    </li>
                    </ul>
                </div>
                </li>

            <li class="nav-item {{isActive currentPath '/products/*/create'}}">
                <a class="nav-link" data-bs-toggle="collapse" href="#products-collapse" aria-expanded="false" aria-controls="products-collapse">
                    <span class="menu-title">Sản phẩm</span>
                    <i class="menu-arrow"></i>
                    <i class="mdi mdi-contacts menu-icon"></i>
                </a>
                <div class="collapse" id="products-collapse">
                    <ul class="nav flex-column sub-menu">
                       <li class="nav-item">
                          <a class="nav-link" href="/me/stored/products">Quản lý sản phẩm</a>
                      </li>
                      <li class="nav-item">
                          <a class="nav-link" href="/products/create">Thêm sản phẩm</a>
                      </li>
                       <li class="nav-item">
                          <a class="nav-link" href="/products/gender/create">Quản lý phụ kiện sản phẩm</a>
                      </li>
                    </ul>
                </div>
            </li>
            <li class="nav-item {{isActive currentPath '/shops/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#forms" aria-expanded="false" aria-controls="forms">
                <span class="menu-title">Cửa hàng</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-format-list-bulleted menu-icon"></i>
              </a>
              <div class="collapse" id="forms">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/me/stored/shops">Quản lý cửa hàng</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/shops/create">Thêm cửa hàng</a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/orders/*/*'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#orders" aria-expanded="false" aria-controls="orders">
                <span class="menu-title">Hóa đơn</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-chart-bar menu-icon"></i>
              </a>
              <div class="collapse" id="orders">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/orders/show">Quản lý hóa đơn</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" href="/orders/create">Tạo hóa đơn</a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/discounts/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#charts" aria-expanded="false" aria-controls="charts">
                <span class="menu-title">Giảm giá</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-chart-bar menu-icon"></i>
              </a>
              <div class="collapse" id="charts">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/discounts/create">Quản lý giảm giá</a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/news/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#tables" aria-expanded="false" aria-controls="tables">
                <span class="menu-title">Tin tức</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-table-large menu-icon"></i>
              </a>
              <div class="collapse" id="tables">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/news/create">Quản lý tin tức</a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/comments/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#auth" aria-expanded="false" aria-controls="auth">
                <span class="menu-title">Bình luận</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-lock menu-icon"></i>
              </a>
              <div class="collapse" id="auth">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/comments/create"> Quản lý bình luận </a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/likes/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#like" aria-expanded="false" aria-controls="like">
                <span class="menu-title">Lượt thích</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-lock menu-icon"></i>
              </a>
              <div class="collapse" id="like">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/likes/create"> Quản lý lượt thích </a>
                  </li>
                </ul>
              </div>
            </li>
            <li class="nav-item {{isActive currentPath '/reviews/create'}}">
              <a class="nav-link" data-bs-toggle="collapse" href="#review" aria-expanded="false" aria-controls="review">
                <span class="menu-title">Đánh giá</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-lock menu-icon"></i>
              </a>
              <div class="collapse" id="review">
                <ul class="nav flex-column sub-menu">
                  <li class="nav-item">
                    <a class="nav-link" href="/reviews/create"> Quản lý đánh giá </a>
                  </li>
                </ul>
              </div>
            </li>
          </ul>
        </nav>
         <div class="main-panel">
            {{{body}}}
         </div>
      </div>

        </div>

        {{!-- Bootstrap --}}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        {{!-- JQuery --}}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        
        {{!-- Select2 --}}
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap-select/dist/js/bootstrap-select.min.js"></script>

        <script src="/js/jquery.cookie.js"></script>
        <script src="/vendors/chart.js/chart.umd.js"></script>
        <script src="/js/settings.js"></script>
        <script src="/js/off-canvas.js"></script>
        <script src="/js/misc.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.8.1/socket.io.js" integrity="sha512-8BHxHDLsOHx+flIrQ0DrZcea7MkHqRU5GbTHmbdzMRnAaoCIkZ97PqZcXJkKZckMMhqfoeaJE+DNUVuyoQsO3Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

        {{!-- JS chat --}}
        <script src="/assets/libs/simplebar/simplebar.min.js"></script>
        <script src="/assets/libs/node-waves/waves.min.js"></script>
        <script src="/assets/libs/magnific-popup/jquery.magnific-popup.min.js"></script>
        <script src="/assets/libs/owl.carousel/owl.carousel.min.js"></script>
        <script src="/assets/js/pages/index.init.js"></script>
        <script src="/assets/js/app.js"></script>

        <!-- Custom js for this page -->
        <script src="/js/dashboard.js"></script>
        <script src='/js/chat.js'></script>

        {{!-- Flatpickr --}}
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>

        <script>
          document.addEventListener('DOMContentLoaded', function() {
             $(document).ready(function() {
                $('.selectpicker').selectpicker();
            });
          })

          const CURRENT_USER_ID = {{  user._id }};
          const CURRENT_USER_NAME = '{{ user.firstName }} {{ user.lastName }}';
          const CURRENT_USER_AVATAR = '{{ user.avatar }}';
        </script>
    </body>
</html>