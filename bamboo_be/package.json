{
    "name": "bamboo_be",
    "version": "1.0.0",
    "description": "Backend E-Commerce Bamboo",
    "main": "src/index.js",
    "scripts": {
        "beautiful": "lint-staged",
        "dev": "nodemon --inspect src/index.js",
        "render": "node src/index.js",
        "watch": "sass --watch src/resources/scss/app.scss:src/public/css/app.css",
        "start": "pm2 start ecosystem.config.js && pm2 save",
        "stop": "pm2 stop all && pm2 delete all",
        "build": "echo 'Nothing to build'",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "ThanhhDanh",
    "license": "ISC",
    "lint-staged": {
        "src/**/*.{js,json,scss,hbs}": "prettier --single-quote --trailing-comma all --write --tab-width 4"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "dependencies": {
        "axios": "^1.11.0",
        "bcryptjs": "^3.0.2",
        "bootstrap": "^5.2.3",
        "bullmq": "^5.56.9",
        "cloudinary": "^1.30.0",
        "connect-mongo": "^5.1.0",
        "express": "^4.21.2",
        "express-handlebars": "^8.0.1",
        "express-session": "^1.18.1",
        "express-validator": "^7.2.1",
        "ioredis": "^5.7.0",
        "method-override": "^3.0.0",
        "moment": "^2.30.1",
        "mongoose": "^8.9.5",
        "mongoose-delete": "^1.0.2",
        "mongoose-sequence": "^6.0.1",
        "mongoose-slug-updater": "^3.3.0",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "pm2": "^6.0.8",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^15.3.0",
        "morgan": "^1.10.0",
        "nodemon": "^3.1.9",
        "prettier": "^3.4.2",
        "sass": "^1.83.1"
    }
}
